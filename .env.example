# ---------------------------------------------------------------------------
# SENTINELX configuration example. Copy to .env and edit. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=SENTINELX
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (SQLite default; PostgreSQL example commented) ---
DATABASE_URL=sqlite:///./data/sentinelx.db
# DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx@localhost:5432/sentinelx

# --- CORS (comma separated origins) ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# --- Demo data ---
SEED_DEMO_DATA=true
SIMULATION_MODE=true

# --- Detection defaults ---
BRUTE_FORCE_WINDOW_SECONDS=300
BRUTE_FORCE_THRESHOLD=5
FAILED_SUCCESS_WINDOW_SECONDS=600
MAX_SIGMA_ALERTS_PER_RUN=500

# --- LLM (optional). Leave blank to use the deterministic fallback mode. ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0

# --- Threat intelligence (optional). Keys are read from env only. ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=10
THREAT_INTEL_CACHE_TTL_SECONDS=86400

# --- Elasticsearch (optional) ---
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=sentinelx-events
ELASTICSEARCH_API_KEY=

# --- Wazuh (optional) ---
WAZUH_URL=
WAZUH_USER=
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=true

# --- Response execution safety ---
# Real response actions are disabled by default. Only simulated execution is
# implemented. Do not enable without an authenticated, authorised operator.
RESPONSE_EXECUTION_ENABLED=false

# --- SXUF forwarder registry / retention ---
FORWARDER_OFFLINE_AFTER_SECONDS=300
AGENT_KEY_DEFAULT_TTL_DAYS=365
LOG_RETENTION_DAYS=90

# Run detection + correlation automatically after each forwarded batch
AUTO_PROCESS_FORWARDED=true

# --- Optional Redis (in-process fallback used when unset) ---
REDIS_URL=

# --- Frontend ---
# The React SPA is served from frontend/dist when built. The zero-build
# dashboard at /static remains available as a fallback.
